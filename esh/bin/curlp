#!/bin/sh

printf2()
{
  printf >&2 "%s\n" "$@"
}

curlp()
{
  curlp__usage="usage: curlp [-r x] ..."

  curlp__retry=0
  OPTIND=1
  while getopts :hxr: opt; do
    case $opt in
      h) printf2 "$curlp__usage"
         exit 0 ;;
      x) set -x ;;
      r) curlp__retry="$OPTARG" ;;
    esac
  done
  shift $(($OPTIND - 1))

  curl \
    --fail --silent --show-error \
    --location \
    --retry "$curlp__retry" --retry-all-errors \
    "$@"
}

curlp "$@"
