#!/bin/sh

printf2()
{
  printf >&2 "%s\n" "$@"
}

curl_json()
{
  curl_json__usage="usage: curl_json [-r x] ..."

  curl_json__retry=0
  OPTIND=1
  while getopts :hxr: opt; do
    case $opt in
      h) printf2 "$curl_json__usage"
         exit 0 ;;
      x) set -x ;;
      r) curl_json__retry="$OPTARG" ;;
    esac
  done
  shift $(($OPTIND - 1))

  curl \
    --fail --silent --show-error \
    --location \
    --retry "$curl_json__retry" --retry-all-errors \
    -H 'Cache-Control: no-cache' \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json' \
    "$@"
}

curl_json "$@"
